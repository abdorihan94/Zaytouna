
function initializeSystem(){var headers={CONFIG:['key','value'],SEQUENCES:['id','key','value'],USERS:['id','email','name','roles','status'],ROLES:['id','code','name','status'],ROLE_PERMISSIONS:['id','role','permission'],USER_ASSIGNMENTS:['id','userEmail','entityType','entityId'],AUDIT_LOG:['id','timestamp','userEmail','action','entity','entityId','before','after'],SYSTEM_LOG:['id','timestamp','level','message','context'],BACKUP_JOBS:['id','createdAt','status'],ARCHIVE_INDEX:['id','entity','entityId','archivedAt']};SHEETS.forEach(function(n){DatabaseService.ensureSheet(n,headers[n]||['id','status','createdAt','updatedAt']);});var c=DatabaseService.rows('CONFIG');if(!c.some(function(x){return x.key==='MILESTONE';}))DatabaseService.append('CONFIG',{key:'MILESTONE',value:CONFIG.MILESTONE});ROLES&&Object.keys(ROLES).forEach(function(k){if(!DatabaseService.rows('ROLES').some(function(r){return r.code===k;}))DatabaseService.append('ROLES',{id:'ROLE-'+k,code:k,name:ROLES[k],status:'ACTIVE'});});return diagnostics_();}
