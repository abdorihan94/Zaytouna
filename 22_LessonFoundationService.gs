
function listLessons(filters){authorize_('VIEW_LESSONS');ensureLessonSchema_();var rows=DatabaseService.rows('LESSONS');filters=filters||{};var query=safeText_(filters.query||'').toLowerCase();var status=safeText_(filters.status||'');var sort=safeText_(filters.sort||'updatedAt');var pageSize=Number(filters.pageSize||25)||25;var page=Number(filters.page||1)||1;rows=rows.filter(function(r){var matches=!status||String(r.status)===status;if(!matches)return false;if(!query)return true;return JSON.stringify(r).toLowerCase().indexOf(query)>=0;});if(sort==='title'){rows=rows.sort(function(a,b){return String(a.title||'').localeCompare(String(b.title||''));});}else if(sort==='status'){rows=rows.sort(function(a,b){return String(a.status||'').localeCompare(String(b.status||''));});}else {rows=rows.sort(function(a,b){return new Date(b.updatedAt||b.createdAt||0)-new Date(a.updatedAt||a.createdAt||0);});}var start=(page-1)*pageSize;return rows.slice(start,start+pageSize);}
