
var MasterDataService={list:function(entity,query){authorize_('VIEW_'+entity);var rows=DatabaseService.rows(entity);query=safeText_(query).toLowerCase();return query?rows.filter(function(r){return JSON.stringify(r).toLowerCase().indexOf(query)>=0;}):rows;},save:function(entity,data){authorize_('MANAGE_'+entity);data=data||{};if(!data.id)data.id=nextId_(entity.toLowerCase().replace(/s$/,''));data.status=data.status||'ACTIVE';data.updatedAt=now_();var old=DatabaseService.find(entity,data.id);DatabaseService.upsert(entity,data);audit_(old?'UPDATE':'CREATE',entity,data.id,old,data);return data;},archive:function(entity,id){authorize_('MANAGE_'+entity);var old=DatabaseService.find(entity,id);if(!old)throw Error('السجل غير موجود');old.status='ARCHIVED';old.updatedAt=now_();DatabaseService.upsert(entity,old);audit_('ARCHIVE',entity,id,old,{status:'ARCHIVED'});return old;}};
