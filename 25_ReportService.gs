// Milestone 7: Student Reports & Report Generation Engine.
// Reports are generated directly from EVALUATIONS/EVALUATION_RESPONSES using the
// historical EVALUATION_FORMS/EVALUATION_CRITERIA version tied to each evaluation
// (via historicalForm_/criteriaForForm_ from 24_EvaluationService.gs), never from
// manual entry or a duplicated evaluation store. History is append-only: a
// regenerated report supersedes the previous ACTIVE report row instead of
// overwriting/deleting it.

function ensureReportSchema_(){
  DatabaseService.ensureSheet('REPORTS',['id','studentId','classId','academicYearId','term','startDate','endDate','status','version','regeneratedFromId','sourceEvaluationIds','formVersionsJson','summaryJson','evaluationCount','templateId','templateVersion','documentFileId','pdfFileId','generatedBy','generatedAt','createdAt','updatedAt']);
  DatabaseService.ensureSheet('FILES',['id','entityType','entityId','type','fileName','driveFileId','folderPath','mimeType','templateId','templateVersion','version','metadata','status','createdAt','updatedAt']);
}

function reportPermission_(p){authorize_(p);}

function safeJsonParse_(text,fallback){if(text===null||text===undefined||text==='')return fallback;if(typeof text!=='string')return text;try{return JSON.parse(text);}catch(e){return fallback;}}

function getActiveReportTemplate_(){var cfg=DatabaseService.rows('CONFIG')||[];var matches=cfg.filter(function(r){return r.key===CONFIG.ACTIVE_REPORT_TEMPLATE_ID_KEY;});var match=matches[matches.length-1];if(match&&safeText_(match.value))return match.value;return safeText_(PropertiesService.getScriptProperties().getProperty(CONFIG.ACTIVE_REPORT_TEMPLATE_ID_KEY));}

function getActiveReportTemplateVersion_(){var cfg=DatabaseService.rows('CONFIG')||[];var matches=cfg.filter(function(r){return r.key===CONFIG.ACTIVE_REPORT_TEMPLATE_VERSION_KEY;});var match=matches[matches.length-1];if(match&&safeText_(match.value))return match.value;return safeText_(PropertiesService.getScriptProperties().getProperty(CONFIG.ACTIVE_REPORT_TEMPLATE_VERSION_KEY))||'1.0';}

// Report scope: elevated roles (ADMIN/MANAGEMENT/SUPERVISOR) see every student's
// reports; everyone else (typically TEACHER) is restricted to classes assigned to
// them in USER_ASSIGNMENTS, the same table Milestone 6 uses for evaluation scope.
function reportScope_(){var email=currentEmail_();var rows=DatabaseService.rows('USER_ASSIGNMENTS')||[];return {all:UserRoleService.hasRole('ADMIN')||UserRoleService.hasRole('MANAGEMENT')||UserRoleService.hasRole('SUPERVISOR'),classes:rows.filter(function(r){return String(r.userEmail||'').toLowerCase()===email&&/CLASS/i.test(r.entityType||'');}).map(function(r){return String(r.entityId);}),subjects:rows.filter(function(r){return String(r.userEmail||'').toLowerCase()===email&&/SUBJECT/i.test(r.entityType||'');}).map(function(r){return String(r.entityId);})};}

function reportStudentInScope_(student,scope){if(!student)return false;if(scope.all)return true;return scope.classes.indexOf(String(student.classId||''))>=0;}

// Validates the explicit reporting period: academic year (must exist) + term
// (from the fixed REPORT_TERMS list) + optional explicit date-range override,
// applicable to any term (used to further narrow inclusion by evaluation date).
function validateReportPeriod_(payload){payload=payload||{};var academicYearId=safeText_(payload.academicYearId);if(!academicYearId)throw Error('العام الدراسي مطلوب لإنشاء التقرير');var year=DatabaseService.find('ACADEMIC_YEARS',academicYearId);if(!year)throw Error('العام الدراسي المحدد غير موجود');var term=safeText_(payload.term||'FULL_YEAR').toUpperCase();if(!REPORT_TERMS[term])throw Error('الفترة الدراسية المحددة غير صالحة');var startDate=payload.startDate?new Date(payload.startDate):null;var endDate=payload.endDate?new Date(payload.endDate):null;if(startDate&&isNaN(startDate.getTime()))throw Error('تاريخ بداية الفترة غير صالح');if(endDate&&isNaN(endDate.getTime()))throw Error('تاريخ نهاية الفترة غير صالح');if(term==='CUSTOM'&&(!startDate||!endDate))throw Error('يجب تحديد تاريخ البداية والنهاية للفترة المخصصة');if(startDate&&endDate&&startDate>endDate)throw Error('تاريخ البداية يجب أن يسبق تاريخ النهاية');return {academicYearId:academicYearId,academicYearName:safeText_(year.name)||academicYearId,term:term,termLabel:REPORT_TERMS[term],startDate:startDate?startDate.toISOString():'',endDate:endDate?endDate.toISOString():''};}

// Eligible evaluations = same student + same academic year + status SUBMITTED or
// LOCKED (REPORT_INCLUDED_EVALUATION_STATUSES) + within the caller's assignment
// scope (reusing evaluationInScope_ from 24_EvaluationService.gs) + optionally
// within the explicit date-range override when one was supplied.
function gatherEligibleEvaluations_(studentId,period,scope){ensureEvaluationSchema_();var rows=DatabaseService.rows('EVALUATIONS')||[];return rows.filter(function(e){if(String(e.studentId)!==String(studentId))return false;if(String(e.academicYearId)!==String(period.academicYearId))return false;if(REPORT_INCLUDED_EVALUATION_STATUSES.indexOf(String(e.status))<0)return false;if(!evaluationInScope_(e,scope))return false;if(period.startDate||period.endDate){var ts=e.submittedAt||e.lockedAt||e.updatedAt;var d=ts?new Date(ts):null;if(!d||isNaN(d.getTime()))return false;if(period.startDate&&d<new Date(period.startDate))return false;if(period.endDate&&d>new Date(period.endDate))return false;}return true;}).sort(function(a,b){return new Date(a.submittedAt||a.updatedAt||0)-new Date(b.submittedAt||b.updatedAt||0);});}

// Assembles report entries strictly from the historical form/criteria version
// recorded on each evaluation, so archiving/replacing a form later never changes
// how an already-completed evaluation is represented in a report.
function assembleReportEntries_(evaluations){var evalIds=evaluations.map(function(e){return String(e.id);});var allResponses=(DatabaseService.rows('EVALUATION_RESPONSES')||[]).filter(function(r){return evalIds.indexOf(String(r.evaluationId))>=0;});var formCache={};return evaluations.map(function(e){var cacheKey=String(e.formId)+'@'+String(e.formVersion);var cached=formCache[cacheKey];if(!cached){var form=historicalForm_(e.formId,e.formVersion);cached=formCache[cacheKey]={form:form,criteria:criteriaForForm_(form)};}var criteriaById={};cached.criteria.forEach(function(c){criteriaById[String(c.id)]=c;});var responses=allResponses.filter(function(r){return String(r.evaluationId)===String(e.id);}).map(function(r){var c=criteriaById[String(r.criterionId)];return {criterionId:String(r.criterionId),label:c?c.label:String(r.criterionId),responseType:c?String(c.responseType||'TEXT').toUpperCase():'TEXT',value:safeText_(r.value)};});return {evaluationId:e.id,formId:cached.form.id,formVersion:cached.form.version,formTitle:cached.form.title,classId:e.classId,subjectId:e.subjectId,teacherEmail:e.teacherEmail,submittedAt:e.submittedAt||e.updatedAt,responses:responses};});}

// Explicit, documented summary rule (no invented pedagogical scoring):
// - NUMBER/RATING criteria: arithmetic average of the numeric responses recorded.
// - SELECT/RADIO criteria: frequency distribution of the recorded option values.
// - Any other type (e.g. TEXT): the verbatim list of recorded values, unmodified.
// Criteria are grouped by label across all included evaluations/forms.
function computeReportSummary_(entries){var groups={};var order=[];entries.forEach(function(entry){entry.responses.forEach(function(r){if(!safeText_(r.value))return;if(!groups[r.label]){groups[r.label]={label:r.label,responseType:r.responseType,values:[]};order.push(r.label);}groups[r.label].values.push(r.value);});});var criteria=order.map(function(label){var g=groups[label];var isNumeric=g.responseType==='NUMBER'||g.responseType==='RATING';var isChoice=g.responseType==='SELECT'||g.responseType==='RADIO';var out={label:g.label,responseType:g.responseType,count:g.values.length,average:null,distribution:null,values:null};if(isNumeric){var numeric=g.values.map(Number).filter(function(n){return isFinite(n);});out.average=numeric.length?Math.round((numeric.reduce(function(a,b){return a+b;},0)/numeric.length)*100)/100:null;}else if(isChoice){var dist={};g.values.forEach(function(v){dist[v]=(dist[v]||0)+1;});out.distribution=dist;}else{out.values=g.values;}return out;});var forms=[];var seen={};entries.forEach(function(e){var key=String(e.formId)+'@'+String(e.formVersion);if(!seen[key]){seen[key]=true;forms.push({formId:e.formId,formVersion:e.formVersion,formTitle:e.formTitle});}});return {evaluationsIncluded:entries.length,formsUsed:forms,criteria:criteria};}

function findActiveReport_(studentId,period){var rows=DatabaseService.rows('REPORTS')||[];return rows.filter(function(r){return String(r.studentId)===String(studentId)&&String(r.academicYearId)===String(period.academicYearId)&&String(r.term)===String(period.term)&&String(r.status)==='ACTIVE';}).sort(function(a,b){return Number(b.version||0)-Number(a.version||0);})[0]||null;}

function getReportFolder_(){var folders=DriveService.folders();return folders['03 تقارير الطلاب']||DriveService.root();}

function resolveReportTemplateFile_(templateId){try{return DriveApp.getFileById(templateId);}catch(e){logSystem_('ERROR','Report template inaccessible: '+e.message,{templateId:templateId});throw Error('تعذر الوصول إلى قالب التقرير الحالي، يرجى مراجعة الإدارة');}}

function buildReportPlaceholderValues_(student,period,summary){var lines=summary.criteria.map(function(c){var value=c.average!=null?String(c.average):(c.distribution?Object.keys(c.distribution).map(function(k){return k+': '+c.distribution[k];}).join('، '):(c.values||[]).join('، '));return c.label+': '+value;});return {'student.name':safeText_(student.name),'student.id':safeText_(student.id),'academicYear':period.academicYearName,'term':period.termLabel,'period.start':period.startDate||'',
'period.end':period.endDate||'','evaluations.count':String(summary.evaluationsIncluded),'summary.table':lines.join('\n')};}

// Placeholder rendering is intentionally isolated from business/data assembly
// (assembleReportEntries_/computeReportSummary_ above): this function only ever
// writes already-computed values into `{{placeholder}}` tokens in the template copy.
function applyReportPlaceholders_(doc,values){var body=doc.getBody();Object.keys(values).forEach(function(key){var pattern='\\{\\{\\s*'+key.replace(/\./g,'\\.')+'\\s*\\}\\}';body.replaceText(pattern,String(values[key]||'').replace(/\$/g,'$$$$'));});}

function generateReportDocument_(student,period,summary,templateId,folder,fileBaseName){var templateFile=resolveReportTemplateFile_(templateId);var copy=templateFile.makeCopy(fileBaseName,folder);var doc=DocumentApp.openById(copy.getId());applyReportPlaceholders_(doc,buildReportPlaceholderValues_(student,period,summary));doc.saveAndClose();return copy;}

function registerReportFile_(reportId,type,fileName,driveFileId,folderPath,templateId,templateVersion,version,metadata){ensureReportSchema_();var fileRecord={id:uuid_(),entityType:'REPORT',entityId:String(reportId),type:String(type||'').toUpperCase(),fileName:safeText_(fileName)||('report-'+String(reportId)),driveFileId:safeText_(driveFileId)||'',folderPath:safeText_(folderPath)||'',mimeType:'application/octet-stream',templateId:safeText_(templateId||''),templateVersion:safeText_(templateVersion||''),version:Number(version||1),metadata:json_(metadata||{}),status:'ACTIVE',createdAt:now_(),updatedAt:now_()};DatabaseService.append('FILES',fileRecord);return fileRecord;}

function findReportFileRecord_(reportId,type){var rows=DatabaseService.rows('FILES')||[];return rows.filter(function(r){return String(r.entityType)==='REPORT'&&String(r.entityId)===String(reportId)&&String(r.type||'').toUpperCase()===String(type||'').toUpperCase();}).sort(function(a,b){return Number(b.version||0)-Number(a.version||0);})[0]||null;}

function decorateReport_(report){return {report:report,summary:safeJsonParse_(report.summaryJson,{}),sourceEvaluationIds:safeJsonParse_(report.sourceEvaluationIds,[]),formsUsed:safeJsonParse_(report.formVersionsJson,[])};}

function getReportById_(reportId){ensureReportSchema_();var report=DatabaseService.find('REPORTS',reportId);if(!report)throw Error('التقرير غير موجود');return decorateReport_(report);}

// Core engine: validate request -> gather eligible evaluations -> assemble data
// -> compute summary -> resolve template -> generate Doc+PDF -> register FILES
// -> create/version REPORTS metadata -> audit. `regenerate` controls the
// duplicate/versioning strategy explicitly (see README section on Milestone 7).
function generateReportRecord_(payload,regenerate){reportPermission_('GENERATE_REPORTS');ensureReportSchema_();payload=payload||{};var studentId=safeText_(payload.studentId||payload.id);if(!studentId)throw Error('معرّف الطالب مطلوب');var student=DatabaseService.find('STUDENTS',studentId);if(!student)throw Error('الطالب غير موجود');var scope=reportScope_();if(!reportStudentInScope_(student,scope)){logSystem_('WARN','Report access denied - student out of scope',{studentId:studentId,userEmail:currentEmail_()});throw Error('لا تملك صلاحية إنشاء تقرير لهذا الطالب');}var period=validateReportPeriod_(payload);audit_('REPORT_REQUEST_GENERATE','REPORTS',null,null,{studentId:studentId,period:period,regenerate:!!regenerate});var evaluations=gatherEligibleEvaluations_(studentId,period,scope);if(!evaluations.length){logSystem_('WARN','No eligible evaluation data for report',{studentId:studentId,period:period});throw Error('لا توجد بيانات تقييم مؤهلة لهذا الطالب خلال الفترة المحددة');}var templateId=safeText_(getActiveReportTemplate_());if(!templateId){logSystem_('ERROR','Active report template not configured',{studentId:studentId});throw Error('لا يوجد قالب تقرير نشط حالياً، يرجى مراجعة الإدارة');}var templateVersion=getActiveReportTemplateVersion_();var existing=findActiveReport_(studentId,period);var sourceIds=evaluations.map(function(e){return String(e.id);}).sort();if(existing){var existingIds=(safeJsonParse_(existing.sourceEvaluationIds,[])||[]).slice().sort();var identical=json_(existingIds)===json_(sourceIds)&&String(existing.templateId)===String(templateId);if(identical){audit_('REPORT_OPEN_EXISTING','REPORTS',existing.id,null,{studentId:studentId});return getReportById_(existing.id);}if(!regenerate){throw Error('يوجد تقرير سابق لنفس الطالب والفترة، استخدم إعادة التوليد لتضمين البيانات المحدّثة');}}var entries=assembleReportEntries_(evaluations);var summary=computeReportSummary_(entries);var folder=getReportFolder_();var fileBaseName=(student.name||studentId)+' - '+period.termLabel+' - '+period.academicYearName;var reportId=nextId_('report');var version=existing?Number(existing.version||1)+1:1;var docFile=generateReportDocument_(student,period,summary,templateId,folder,fileBaseName);var folderName=folder.getName?folder.getName():'03 تقارير الطلاب';var docRecord=registerReportFile_(reportId,REPORT_FILE_TYPES.DOCUMENT,fileBaseName,docFile.getId(),folderName,templateId,templateVersion,version,{generatedBy:currentEmail_(),generatedAt:now_()});var pdfBlob=DriveApp.getFileById(docFile.getId()).getAs('application/pdf');var pdfFile=folder.createFile(pdfBlob.setName(fileBaseName+'.pdf'));var pdfRecord=registerReportFile_(reportId,REPORT_FILE_TYPES.PDF,fileBaseName+'.pdf',pdfFile.getId(),folderName,templateId,templateVersion,version,{sourceDocumentId:docFile.getId(),generatedBy:currentEmail_(),generatedAt:now_()});if(existing){existing.status='SUPERSEDED';existing.updatedAt=now_();DatabaseService.upsert('REPORTS',existing);}var report={id:reportId,studentId:studentId,classId:String(student.classId||''),academicYearId:period.academicYearId,term:period.term,startDate:period.startDate,endDate:period.endDate,status:'ACTIVE',version:version,regeneratedFromId:existing?String(existing.id):'',sourceEvaluationIds:json_(sourceIds),formVersionsJson:json_(summary.formsUsed),summaryJson:json_(summary),evaluationCount:entries.length,templateId:templateId,templateVersion:templateVersion,documentFileId:docRecord.id,pdfFileId:pdfRecord.id,generatedBy:currentEmail_(),generatedAt:now_(),createdAt:existing?existing.createdAt||now_():now_(),updatedAt:now_()};DatabaseService.upsert('REPORTS',report);audit_(existing?'REPORT_REGENERATE':'REPORT_GENERATE','REPORTS',reportId,existing||null,report);logSystem_('INFO','Report generated',{reportId:reportId,studentId:studentId,evaluationCount:entries.length,version:version});return getReportById_(reportId);}

function reportGet_(reportId){reportPermission_('VIEW_REPORTS');ensureReportSchema_();var report=DatabaseService.find('REPORTS',reportId);if(!report)throw Error('التقرير غير موجود');var student=DatabaseService.find('STUDENTS',report.studentId);var scope=reportScope_();if(!reportStudentInScope_(student,scope)){logSystem_('WARN','Report access denied',{reportId:reportId,userEmail:currentEmail_()});throw Error('لا تملك صلاحية الاطلاع على هذا التقرير');}return decorateReport_(report);}

function reportsForStudent_(studentId){reportPermission_('VIEW_REPORTS');ensureReportSchema_();var student=DatabaseService.find('STUDENTS',studentId);if(!student)throw Error('الطالب غير موجود');var scope=reportScope_();if(!reportStudentInScope_(student,scope)){logSystem_('WARN','Report history access denied',{studentId:studentId,userEmail:currentEmail_()});throw Error('لا تملك صلاحية الاطلاع على تقارير هذا الطالب');}return (DatabaseService.rows('REPORTS')||[]).filter(function(r){return String(r.studentId)===String(studentId);}).sort(function(a,b){return new Date(b.generatedAt||b.updatedAt||0)-new Date(a.generatedAt||a.updatedAt||0);}).map(decorateReport_);}

function reportStudents_(query){reportPermission_('VIEW_REPORTS');var scope=reportScope_();var rows=DatabaseService.rows('STUDENTS')||[];if(!scope.all)rows=rows.filter(function(s){return scope.classes.indexOf(String(s.classId||''))>=0;});var q=safeText_(query).toLowerCase();return q?rows.filter(function(r){return JSON.stringify(r).toLowerCase().indexOf(q)>=0;}):rows;}

// Never regenerates a file just to be viewed: only reads the already-registered
// FILES record and re-checks the same student-scope rule used everywhere else.
function reportFileAccess_(reportId,type){reportPermission_('VIEW_REPORTS');ensureReportSchema_();var report=DatabaseService.find('REPORTS',reportId);if(!report)throw Error('التقرير غير موجود');var student=DatabaseService.find('STUDENTS',report.studentId);var scope=reportScope_();if(!reportStudentInScope_(student,scope)){logSystem_('WARN','Report file access denied',{reportId:reportId,type:type,userEmail:currentEmail_()});throw Error('لا تملك صلاحية الاطلاع على ملفات هذا التقرير');}var fileRecord=findReportFileRecord_(reportId,type);if(!fileRecord||!safeText_(fileRecord.driveFileId))throw Error('لا يوجد ملف متاح لهذا التقرير بعد');var driveFile;try{driveFile=DriveApp.getFileById(fileRecord.driveFileId);}catch(e){logSystem_('ERROR','Report file inaccessible: '+e.message,{reportId:reportId,type:type});throw Error('تعذر الوصول إلى ملف التقرير حالياً');}var access={id:fileRecord.id,fileName:fileRecord.fileName,type:fileRecord.type,version:fileRecord.version,url:driveFile.getUrl()};audit_('REPORT_FILE_ACCESS','FILES',fileRecord.id,null,{reportId:String(reportId),type:String(type||''),accessedBy:currentEmail_()});logSystem_('INFO','Report file accessed',{reportId:reportId,type:type,accessedBy:currentEmail_()});return access;}

var ReportService={students:function(query){return reportStudents_(query);},generate:function(payload){return generateReportRecord_(payload,false);},regenerate:function(payload){return generateReportRecord_(payload,true);},get:function(reportId){return reportGet_(reportId);},history:function(studentId){return reportsForStudent_(studentId);},getFile:function(reportId,type){return reportFileAccess_(reportId,type||'DOCUMENT');}};
