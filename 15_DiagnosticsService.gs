
function diagnostics_(){var ss=DatabaseService.spreadsheet();return {spreadsheet:ss.getId(),sheets:SHEETS.filter(function(n){return !!ss.getSheetByName(n);}),milestone:CONFIG.MILESTONE,lessonStatuses:LESSON_STATUSES,lessonTransitions:LESSON_STATUS_TRANSITIONS};}
function runDiagnostics(){return envelope_(true,diagnostics_(),'تم تشغيل الفحص');}
function runLessonDiagnostics(){var summary={milestone:CONFIG.MILESTONE,validDraftTransition:lessonTransitionAllowed_('DRAFT','SUBMITTED'),validReviewTransition:lessonTransitionAllowed_('UNDER_REVIEW','APPROVED'),validRevisionTransition:lessonTransitionAllowed_('REVISION_REQUIRED','SUBMITTED'),invalidTransition:lessonTransitionAllowed_('DRAFT','APPROVED')};return envelope_(true,summary,'تم تشغيل تشخيص سير الدروس');}
// Milestone 5: static self-check for the teacher workspace visibility rule,
// exercised against sample rows so it never touches Sheets/Session/Drive.
function runWorkspaceVisibilityDiagnostics_(){var sample=[{id:'L1',teacherEmail:'teacher@a.com',status:'DRAFT'},{id:'L2',teacherEmail:'other@a.com',status:'DRAFT'},{id:'L3',teacherEmail:'other@a.com',status:'PUBLISHED'}];var teacherView=filterLessonsByVisibility_(sample,{elevated:false,email:'teacher@a.com'});var elevatedView=filterLessonsByVisibility_(sample,{elevated:true,email:'teacher@a.com'});var summary={teacherSeesOwnDraft:teacherView.some(function(r){return r.id==='L1';}),teacherHidesOthersDraft:!teacherView.some(function(r){return r.id==='L2';}),teacherSeesOthersPublished:teacherView.some(function(r){return r.id==='L3';}),elevatedSeesEverything:elevatedView.length===sample.length};return envelope_(true,summary,'تم تشغيل تشخيص مساحة عمل المعلم');}
